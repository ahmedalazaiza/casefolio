        "type": "Problem",
        "props": {
          "id": "Problem-1",
          "eyebrow": "The problem",
          "heading": "Operators were fighting the interface, not the freight",
          "statement": "Dispatchers juggled nine open tabs to assign a single load, and one in five assignments needed a manual correction.",
          "columns": 3,
          "painPoints": [
            {
              "title": "Scattered information",
              "body": "Load, carrier and route data lived on three separate screens with no shared context."
            },
            {
              "title": "Alert fatigue",
              "body": "Every delay fired the same red banner, so critical exceptions were missed or ignored."
            },
            {
              "title": "No keyboard flow",
              "body": "Power users made 300+ assignments per shift, yet every action required the mouse."
            }
