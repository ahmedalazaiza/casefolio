          "accent": "primary"
        }
      },
      {
        "type": "Problem",
        "props": {
          "id": "Problem-1",
          "eyebrow": "The problem",
          "heading": "Motivation died in the first two weeks",
          "statement": "72% of new users stopped opening the app before their tenth workout.",
          "columns": 3,
          "painPoints": [
            {
              "title": "Plans felt rigid",
              "body": "Missing a single day broke the programme, and people felt they had already failed."
            },
            {
              "title": "Too much setup",
              "body": "Onboarding asked 18 questions before showing a single workout."
            },
            {
              "title": "No sense of progress",
              "body": "Stats were buried in a profile tab that almost nobody visited."
            }
          ],
          "background": "background"
        }
      },
      {
        "type": "Process",
        "props": {
          "id": "Process-1",
          "eyebrow": "Process",
          "heading": "Designing for the bad day, not the perfect one",
          "layout": "timeline",
          "accent": "primary",
          "steps": [
            {
              "number": "01",
              "title": "Listen",
              "body": "A three-week diary study with 24 people showed when workouts actually happen — and when they get skipped."
            },
            {
              "number": "02",
              "title": "Reframe",
              "body": "We shifted the core loop from “complete the plan” to “show up today”."
            },
            {
              "number": "03",
              "title": "Prototype",
              "body": "Tested five onboarding concepts in ProtoPie; a three-question flow won clearly."
            },
            {
              "number": "04",
              "title": "Iterate",
              "body": "Weekly releases with in-app feedback, measured against day-30 retention."
