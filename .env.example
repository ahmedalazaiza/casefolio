# Casefolio Environment Variables — Copy to .env and fill in values
# Never commit .env to version control.

# Database (Neon Postgres in prod, local Postgres in dev)
DATABASE_URL=postgresql://localhost:5433/casefolio

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Storage & Delivery (Cloudflare R2 + Cloudflare Images)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=casefolio-assets
CF_IMAGES_ACCOUNT_HASH=your-cloudflare-images-account-hash
CF_IMAGES_API_TOKEN=your-cloudflare-images-api-token

# Payments (Paddle Billing — Merchant of Record)
# Live production values use:
#   PADDLE_ENV=production
#   NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_...
#   PADDLE_API_KEY=pdl_live_apikey_...
#   PADDLE_WEBHOOK_SECRET=pdl_ntfset_...
#   ALLOW_SIMULATED_BILLING=0
# Sandbox values use:
#   PADDLE_ENV=sandbox
#   NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_...
#   PADDLE_API_KEY=pdl_sdbx_apikey_...
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=live_your_paddle_client_token
PADDLE_API_KEY=pdl_live_apikey_your_key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret
PADDLE_ENV=production
# Local/staging only: allow the signed Paddle checkout simulator. Refused when VERCEL_ENV or
# PADDLE_ENV is "production"; a production deployment with this set fails to boot.
ALLOW_SIMULATED_BILLING=0
# Replace with Live `pri_...` IDs (or run `node scripts/migrate-paddle-live.mjs` with PADDLE_LIVE_API_KEY)
# Sandbox reference IDs:
#   Pro Monthly  ($7.99/mo):        pri_01m7t0gab2jcw0d66tbprqby43
#   Pro Yearly   ($79.90/yr):       pri_01m7t0gagw9y3t4zk3qc78grhb
#   Team Monthly ($5.99/seat/mo):   pri_01m7t0gapbtfj3v7a2e32t60ky
#   Team Yearly  ($59.90/seat/yr):  pri_01m7t0gavv92jatgw5g20jf6c1
PADDLE_PRICE_PRO_MONTHLY=pri_live_pro_monthly_id
PADDLE_PRICE_PRO_YEARLY=pri_live_pro_yearly_id
PADDLE_PRICE_TEAM_MONTHLY=pri_live_team_monthly_id
PADDLE_PRICE_TEAM_YEARLY=pri_live_team_yearly_id

# Export Worker (Playwright on Fly.io / Railway)
EXPORT_WORKER_URL=http://localhost:4000
EXPORT_SIGNING_SECRET=replace-with-at-least-32-random-characters
# Concurrent export jobs per worker process (default 1)
EXPORT_WORKER_CONCURRENCY=1

# Product Analytics & Monitoring (PostHog + Sentry)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=https://public@example.ingest.sentry.io/1

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional — Transactional Email Routing (defaults to @casefolio.com mailboxes)
EMAIL_DOMAIN=casefolio.com
ADMIN_ALERT_EMAIL=admin@casefolio.com
SUPPORT_INBOX_EMAIL=support@casefolio.com
EMAIL_FROM_ADMIN=
EMAIL_FROM_SECURITY=
EMAIL_FROM_WELCOME=
EMAIL_FROM_TEAM=
EMAIL_FROM_BILLING=
EMAIL_FROM_NOTIFICATIONS=
EMAIL_FROM_SUPPORT=

# Optional — Operations
# Bearer secret (16+ chars) for the daily Paddle reconciliation cron (Vercel Cron sends it automatically).
CRON_SECRET=
# Mailbox that is bootstrapped as superadmin by `pnpm db:seed` (defaults to admin@casefolio.app).
SEED_ADMIN_EMAIL=
