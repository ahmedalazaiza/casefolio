# Casefolio Environment Variables — Copy to .env and fill in values
# Never commit .env to version control.

# Database (Neon Postgres in prod, local Postgres in dev)
DATABASE_URL=postgresql://localhost:5433/casefolio

# Better Auth
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Transactional Email (Resend)
RESEND_API_KEY=re_your_resend_api_key

# Storage & Delivery (Cloudflare R2 + Cloudflare Images)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=casefolio-assets
CF_IMAGES_ACCOUNT_HASH=your-cloudflare-images-account-hash
CF_IMAGES_API_TOKEN=your-cloudflare-images-api-token

# Payments (Paddle Billing — Merchant of Record)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token
PADDLE_API_KEY=pdl_sdbx_apikey_your_key
PADDLE_WEBHOOK_SECRET=pdl_ntfset_your_webhook_secret
PADDLE_ENV=sandbox
PADDLE_PRICE_PRO_MONTHLY=pri_pro_monthly_id
PADDLE_PRICE_PRO_YEARLY=pri_pro_yearly_id
PADDLE_PRICE_TEAM_MONTHLY=pri_team_monthly_id
PADDLE_PRICE_TEAM_YEARLY=pri_team_yearly_id

# Export Worker (Playwright on Fly.io / Railway)
EXPORT_WORKER_URL=http://localhost:4000
EXPORT_SIGNING_SECRET=replace-with-at-least-32-random-characters

# Product Analytics & Monitoring (PostHog + Sentry)
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=https://public@example.ingest.sentry.io/1

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

